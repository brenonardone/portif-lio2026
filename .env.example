# Copie para .env e ajuste antes de rodar `npm run migrate` / `npm run dev`.
# (o .env real NUNCA vai para o git -- está no .gitignore)
DB_HOST=localhost
DB_PORT=3306
DB_USER=glp_app
DB_PASSWORD=troque-esta-senha
DB_NAME=controle_geral

# Segredo usado para assinar o cookie de sessão (JWT). Gere um valor
# aleatório longo em produção (ex.: `openssl rand -hex 32`).
JWT_SECRET=troque-este-valor-em-producao

# Porta do servidor Express (API + estáticos do build em produção).
APP_PORT=3070

# "false" só em desenvolvimento local sem HTTPS (cookie de sessão sem flag Secure).
COOKIE_SECURE=false

# Usuário administrador criado por `npm run seed` (só se não existir nenhum usuário).
SEED_ADMIN_EMAIL=admin@exemplo.com
SEED_ADMIN_PASSWORD=troque-esta-senha
SEED_ADMIN_NAME=Administrador
